{
  "name": "stobite-lights",
  "productName": "Stobite Lights",
  "version": "1.0.0",
  "description": "Stobite Lights \u2014 a lighting console for Windows 11 (M-PC replacement)",
  "author": "Stobite",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "preview": "node tools/serve.js",
    "test": "node --test test/",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:all": "electron-builder --mac --arm64 --x64 && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.stobite.lights",
    "productName": "Stobite Lights",
    "copyright": "Stobite",
    "files": [
      "main.js",
      "preload.js",
      "net/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "slshow",
        "name": "Stobite Lights Show",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Stobite Lights",
      "artifactName": "Stobite-Lights-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Stobite-Lights-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Stobite-Lights-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Stobite Lights sends DMX to lighting nodes and fixtures on your network (Art-Net and sACN).",
        "NSBluetoothAlwaysUsageDescription": "Stobite Lights can use Bluetooth MIDI controllers."
      }
    },
    "dmg": {
      "title": "Stobite Lights ${version}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}